{
  "name": "helix",
  "version": "0.1.0",
  "private": true,
  "description": "Recursive self-improving agent harness with an immutable event kernel",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "build": "tsc -b",
    "check": "pnpm typecheck && pnpm test",
    "cli": "tsx packages/cli/src/main.ts",
    "dev": "tsx packages/cli/src/main.ts chat",
    "events:tail": "tsx packages/cli/src/main.ts events",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.9"
  },
  "engines": {
    "node": ">=22"
  }
}
